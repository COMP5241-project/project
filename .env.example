# Copy this file to backend/.env and fill in real values
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-public-anon-or-publishable-key
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: override the "Spot the Hallucination" judge model (defaults to a
# free-tier OpenRouter model; paid models return 403 on credit-less keys)
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional: use a different OpenRouter model for instructor course generation
# OPENROUTER_COURSE_MODEL=nvidia/nemotron-3-super-120b-a12b:free